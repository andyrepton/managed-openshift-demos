{
  "$schema": "https://opencode.ai/config.json",
  "model": "vllm/devstral",
  "provider": {
    "vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "vLLM on OpenShift",
      "options": {
        "baseURL": "http://devstral.vllm-model-serving.svc.cluster.local/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "devstral": {
          "name": "Devstral Small 2 24B AWQ",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  }
}
