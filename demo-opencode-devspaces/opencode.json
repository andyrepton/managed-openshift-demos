{
  "$schema": "https://opencode.ai/config.json",
  "model": "vllm/devstral",
  "providers": {
    "vllm": {
      "name": "vLLM on OpenShift",
      "env": ["VLLM_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://devstral-predictor.vllm-model-serving.svc.cluster.local:8000/v1"
      },
      "models": {
        "devstral": {
          "name": "Devstral Small 2 24B AWQ"
        }
      }
    }
  }
}
