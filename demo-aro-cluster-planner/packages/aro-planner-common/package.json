{
  "name": "@aro-planner/common",
  "version": "0.1.0",
  "description": "Sizing, cost and NetworkPolicy logic shared by the UI, the backend and the MCP server",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "estimate": "tsc -p tsconfig.json && node dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
