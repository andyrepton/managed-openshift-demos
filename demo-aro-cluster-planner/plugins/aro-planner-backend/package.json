{
  "name": "@aro-planner/backstage-plugin-aro-planner-backend",
  "version": "0.1.0",
  "description": "Azure price proxy and planning API for the ARO cluster planner",
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "tsc": "tsc",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aro-planner/common": "workspace:*",
    "@backstage/backend-plugin-api": "1.8.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^4.21.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@backstage/cli": "0.36.0",
    "@types/express": "^4.17.21",
    "@types/node": "^24",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.1.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "aro-planner",
    "pluginPackage": "@aro-planner/backstage-plugin-aro-planner-backend"
  },
  "files": [
    "dist"
