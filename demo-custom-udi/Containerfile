# Custom Universal Developer Image for OpenShift Dev Spaces.
#
# Replaces the toolchain versions the shipped UDI carries on RHEL 9:
#   python3  3.9.25   -> 3.14
#   node     22.23.2  -> 24  (not packaged for RHEL 9, so taken from nodejs.org)
#   dotnet   8.0.131  -> 10
#
# Read demo-custom-udi/README.md before changing this file. The placement of
# things is deliberate: with persistUserHome enabled a PVC is mounted over
# /home/user, so anything installed there at build time disappears on first
# start. Tools go in /opt and /usr, never /home/user.

FROM registry.redhat.io/devspaces/udi-rhel9:latest

USER root

# Python 3.14 and .NET 10 are both packaged for RHEL 9.8 already.
# openssl and libbrotli come from the base image and must stay: Code - OSS
# refuses to start without them.
RUN dnf -y install --setopt=install_weak_deps=False \
      python3.14 python3.14-pip python3.14-devel \
      dotnet-sdk-10.0 \
 && dnf clean all \
 && rm -rf /var/cache/dnf

# Node 24 is not in the RHEL 9 module streams, which stop at 22. Install the
# upstream build into /opt, which is outside the persisted home directory.
# The .tar.gz is used rather than the smaller .tar.xz because the base image
# has no xz binary, and gzip avoids installing one just for the build.
ARG NODE_VERSION=v24.22.0
RUN curl -fsSL "https://nodejs.org/dist/${NODE_VERSION}/node-${NODE_VERSION}-linux-x64.tar.gz" \
      -o /tmp/node.tar.gz \
 && mkdir -p /opt/node \
 && tar -xzf /tmp/node.tar.gz -C /opt/node --strip-components=1 \
 && rm -f /tmp/node.tar.gz

# Make the new versions the defaults by replacing the entries in /usr/bin.
#
# /usr/local/bin is NOT on the UDI's PATH, so symlinking there has no effect.
# Editing a shell profile is no good either: those live under /home/user,
# which a PVC mounts over when persistUserHome is enabled. /usr/bin is the
# only place that reliably wins.
#
# Repointing python3 is safe for package management because dnf pins
# "#!/usr/bin/python3.9" rather than following this symlink. A handful of
# unrelated RHEL tools (cockpit-bridge, udica, flatpak helpers) do follow it
# and are untested on 3.14; none is used in a workspace.
RUN ln -sf python3.14 /usr/bin/python3 \
 && ln -sf python3.14 /usr/bin/python \
 && if [ -x /usr/bin/pip3.14 ]; then ln -sf pip3.14 /usr/bin/pip3 && ln -sf pip3.14 /usr/bin/pip; fi \
 && ln -sf /opt/node/bin/node /usr/bin/node \
 && ln -sf /opt/node/bin/npm  /usr/bin/npm \
 && ln -sf /opt/node/bin/npx  /usr/bin/npx

# OpenShift runs the workspace with an arbitrary UID in group 0. Anything not
# group-writable becomes read-only, and a workspace user cannot chgrp it
# themselves, so the permissions have to be baked in here.
RUN chgrp -R 0 /home /opt/node \
 && chmod -R g=u /home /opt/node

USER 10001
ENV HOME=/home/user
