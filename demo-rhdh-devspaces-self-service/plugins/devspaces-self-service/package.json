{
  "name": "@devspaces/backstage-plugin-devspaces-self-service",
  "version": "0.1.0",
  "description": "Self-service Dev Spaces request wizard for Red Hat Developer Hub",
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "main": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "devspaces-self-service",
    "pluginPackage": "@devspaces/backstage-plugin-devspaces-self-service"
  },
  "sideEffects": false,
  "scalprum": {
    "name": "devspaces-self-service.backstage-plugin-devspaces-self-service",
    "exposedModules": {
      "PluginRoot": "./src/index.ts"
    }
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "tsc": "tsc",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"logic is covered in the backend plugin\" && exit 0",
    "clean": "backstage-cli package clean"
  },
  "dependencies": {
    "@backstage/core-components": "0.18.8",
    "@backstage/core-plugin-api": "1.12.4",
    "@backstage/theme": "0.7.2",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "5.18.0",
    "@mui/material": "5.18.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@backstage/cli": "0.36.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "6.30.3",
    "react-router-dom": "6.30.3",
    "typescript": "^5.9.2"
  },
  "files": [
    "dist",
    "dist-scalprum"
  ]
}
