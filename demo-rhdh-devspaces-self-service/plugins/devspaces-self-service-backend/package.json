{
  "name": "@devspaces/backstage-plugin-devspaces-self-service-backend",
  "version": "0.1.0",
  "description": "Provisions Dev Spaces namespaces, quotas and devfiles from a request",
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "tsc": "tsc",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "1.8.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@backstage/cli": "0.36.0",
    "@types/express": "^4.17.21",
    "@types/node": "^24",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.1.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "devspaces-self-service",
    "pluginPackage": "@devspaces/backstage-plugin-devspaces-self-service-backend"
  },
  "files": [
    "dist"
  ]
}
